rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
    match /alunos/{document} {
      allow read, write: if request.auth != null;
    }
    match /exercicios/{document} {
      allow read, write: if request.auth != null;
    }
    match /equipamentos/{document} {
      allow read, write: if request.auth != null;
    }
    match /usuarios/{document} {
      allow read, write: if request.auth != null;
    }
    match /funcionarios/{document} {
      allow read, write: if request.auth != null;
    }
    match /receitas/{document} {
      allow read, write: if request.auth != null;
    }
    match /despesas/{document} {
      allow read, write: if request.auth != null;
    }
    match /logs/{document} {
      allow read, write: if request.auth != null;
    }
    match /config/{document} {
      allow read, write: if request.auth != null;
    }
    match /planos/{document} {
      allow read, write: if request.auth != null;
    }
    match /renovacoes/{document} {
      allow read, write: if request.auth != null;
    }
    match /treinos_ativos/{document} {
      allow read, write: if request.auth != null;
    }
    match /agenda_aulas/{document} {
      allow read, write: if request.auth != null;
    }
    match /agendamentos_fixos/{document} {
      allow read, write: if request.auth != null;
    }
    match /mesociclos/{document} {
      allow read, write: if request.auth != null;
    }
    match /historico_treinos/{document} {
      allow read, write: if request.auth != null;
    }
    match /plano_contas/{document} {
      allow read, write: if request.auth != null;
    }
    match /conciliacao_regras/{document} {
      allow read, write: if request.auth != null;
    }
    match /avaliacoes_fisicas/{document} {
      allow read, write: if true;
    }
  }
}
